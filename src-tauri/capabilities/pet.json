{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "pet",
  "description": "Pet window capabilities",
  "windows": ["pet-*"],
  "permissions": [
    "event:allow-emit",
    "event:allow-listen",
    "window:allow-close",
    "window:allow-set-position",
    "webviewWindow:allow-close"
  ]
}
