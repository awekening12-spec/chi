{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "main",
  "description": "Capabilities for Chiikawa Pet",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "webviewWindow:allow-create",
    "webviewWindow:allow-close",
    "window:allow-close",
    "window:allow-set-position",
    "window:allow-set-size",
    "window:allow-show",
    "window:allow-hide",
    "event:allow-emit",
    "event:allow-listen"
  ]
}
